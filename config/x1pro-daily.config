# Daily-use configuration for Oray X1 Pro.
#
# This is a diffconfig fragment, not a complete .config.  Before invoking
# `make defconfig`, prepare the X1 Pro port and run
# scripts/prepare-argon-packages.sh against the ImmortalWrt source tree.

# Target device
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_oray_x1pro=y

# Basic Web administration
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# DNS/DHCP
#
# pbr domain-based policies require dnsmasq nftset support.
# Replace the default dnsmasq variant with dnsmasq-full.
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-dhcpv6 is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y

# Policy-based routing and diagnostics.
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-i18n-pbr-zh-cn=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y

# USB network tethering: Android RNDIS and common CDC Ethernet/NCM devices.
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y

# Daily administration features
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-app-wifischedule=y
CONFIG_PACKAGE_luci-i18n-wifischedule-zh-cn=y
CONFIG_PACKAGE_luci-app-autoreboot=y

# Local SSH maintenance tools.
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_vim-full=y

# Third-party Argon theme and its configuration application.
# These symbols require package/luci-theme-argon and
# package/luci-app-argon-config to exist before `make defconfig` is run.
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
