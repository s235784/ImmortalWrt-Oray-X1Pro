# Minimal baseline for Oray X1 Pro.
#
# This is a diffconfig, not a complete .config.  Run `make defconfig` after
# copying it into an ImmortalWrt source tree so the build system resolves the
# required target, kernel, driver, and package dependencies.

# Target device
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_oray_x1pro=y

# Minimal local administration: LuCI over HTTPS and Simplified Chinese.
# Remove both lines only when deliberately building an SSH-only image.
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_LUCI_LANG_zh_Hans=y
